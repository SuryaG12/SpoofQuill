{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "spoofquill",
    "main": "dist/worker.py",
    "compatibility_date": "2026-10-27",
    "compatibility_flags": [
        "python_workers"
    ],
    "build": {
        "command": "node scripts/prepare-worker.mjs"
    },
    "workers_dev": true,
    "assets": {
        "directory": "./public/",
        "binding": "ASSETS",
        "run_worker_first": true
    },
    "observability": {
        "enabled": true
    }
}
