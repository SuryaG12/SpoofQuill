{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "spoofquill",
    "main": "worker.py",
    "compatibility_date": "2026-10-27",
    "compatibility_flags": [
        "python_workers"
    ],
    "assets": {
        "directory": "./public/",
        "binding": "ASSETS",
        "run_worker_first": true
    },
    "observability": {
        "enabled": true
    }
}
